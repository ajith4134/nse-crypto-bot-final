# ─────────────────────────────────────────────────────────────
# .env.example — TEMPLATE ONLY. Copy to .env and fill in values.
#   cp .env.example .env
# .env is gitignored and must NEVER be committed.
#
# ⚠️  The keys you pasted in chat are COMPROMISED — rotate them,
#     then put the NEW values here. Leave blank until rotated.
# ─────────────────────────────────────────────────────────────

# ── Source control / data ──
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=
COINALYZE_API_KEY=

# ── Cloud LLM providers ──
CEREBRAS_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_TOKEN=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AISTUDIO_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
ZAI_API_KEY=
ZAI_API_KEY_ID=
DEEPSEEK_API_KEY=
ALIBABA_API_KEY=

# ── Cloudflare ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ── Local LLM fallback (no key needed) ──
# e.g. Ollama / llama.cpp served locally; set base URL if used
LOCAL_LLM_BASE_URL=http://localhost:11434
