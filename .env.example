# ─────────────────────────────────────────────────────────────
# .env.example — TEMPLATE ONLY. Copy to .env and fill in values.
#   cp .env.example .env
# .env is gitignored and must NEVER be committed.
#
# ⚠️  The keys you pasted in chat are COMPROMISED — rotate them,
#     then put the NEW values here. Leave blank until rotated.
# ─────────────────────────────────────────────────────────────

# ── Source control / data ──
GITHUB_TOKEN=
ETHERSCAN_API_KEY=
COINGECKO_API_KEY=
COINALYZE_API_KEY=

# ── Cloud LLM providers ──
CEREBRAS_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_TOKEN=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_AISTUDIO_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
ZAI_API_KEY=
ZAI_API_KEY_ID=
DEEPSEEK_API_KEY=
ALIBABA_API_KEY=

# ── Cloudflare ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=

# ── Local LLM fallback (no key needed) ──
# e.g. Ollama / llama.cpp served locally; set base URL if used
LOCAL_LLM_BASE_URL=http://localhost:11434

# ── Trading Execution Phase (T1 NSE via OpenAlgo) ──
# OpenAlgo is a self-hosted middleware server. Broker API keys (Zerodha/Upstox/
# Angel One) are configured INSIDE OpenAlgo, NOT here. Copy the API key shown in
# the OpenAlgo web app (http://127.0.0.1:5000) into OPENALGO_API_KEY below.
OPENALGO_API_KEY=
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765
# TRADING_MODE: "paper" (OpenAlgo sandbox) or "live" (real money). Defaults to
# paper. Switch to live only after paper is verified.
TRADING_MODE=paper

# ── Crypto Trading (T2 via ccxt) ──
# OPTIONAL: public market data + the paper-fill simulator need NO keys. Only LIVE
# crypto order placement requires these. Leave blank for paper trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Comma-separated ccxt exchange ids to use (default: binance,bybit). Override if
# one is geo-blocked from your host (e.g. okx,kraken,kucoin).
CRYPTO_EXCHANGES=binance,bybit
CRYPTO_DEFAULT_EXCHANGE=binance
CRYPTO_QUOTE=USDT

# ── Telegram Alerts + Automation (T7) ──
# OPTIONAL: the alert pipeline runs fully offline (dry-run) without these. Set BOTH to
# enable LIVE Telegram alerts + the /positions /pnl /kill command bot. Create a bot via
# @BotFather for the token; TELEGRAM_CHAT_ID is the chat/channel to message. PLACEHOLDERS
# only — never commit real values (.env is gitignored).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Semantic Memory (T8.4 — episodic experience bank + mem0 text memory) ──
# OPTIONAL: the experience bank (LanceDB CBR) + semantic memory run fully offline as a
# dry-run note store. Set MEM0_ENABLED=1 WITH an OpenAI-compatible API key/base to
# activate REAL mem0 (LLM-extracted, consolidated, vector-searchable) semantic memory;
# leave blank for the functional dry-run. PLACEHOLDERS only — never commit real secrets.
MEM0_ENABLED=
OPENAI_BASE_URL=

# ── Autonomous News Research + Sentiment (T8.7) ──
# OPTIONAL: news/sentiment runs fully offline — the default scorer is VENDORED VADER
# (vendor/vaderSentiment, finance-lexicon boosted) on CPU, no download. Set
# GPT_RESEARCHER_ENABLED=1 (WITH gpt-researcher installed + an LLM key) to enable
# NewsResearcher.autonomous_research deep web research; leave blank for the gated note.
# FinBERT activates automatically if `transformers` is installed (SentimentScorer
# backend='finbert'/'auto'), else it cleanly falls back to VADER. No secrets here.
GPT_RESEARCHER_ENABLED=

# ── Skill Library + Self-Improvement + Observability (T8.8) ──
# OPTIONAL: all of T8.8 runs fully offline. The CPU SelfImprover (hill-climb over
# strategy/policy params), the Voyager-pattern SkillLibrary, and the local BrainTracer
# need NO keys. Two gated upgrades:
#   • DSPy/GEPA LLM-program self-improvement activates with DSPY_ENABLED=1 + an
#     OpenAI-compatible key (OPENAI_API_KEY/OPENAI_BASE_URL above); DSPY_MODEL optional.
#   • Langfuse tracing EXPORTS the Stream-of-Mind spans when LANGFUSE_PUBLIC_KEY +
#     LANGFUSE_SECRET_KEY are set; leave blank for the local in-memory tracer.
# PLACEHOLDERS only — never commit real secrets (.env is gitignored).
DSPY_ENABLED=
DSPY_MODEL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Advanced Intelligence (T8 DEFERRED — advintel + brain engines) ──
# OPTIONAL: every advanced-intelligence source runs fully OFFLINE in run_advintel.py via
# injected stub fetchers + seeded data. For LIVE use:
#   • Crypto liquidation heatmap (Coinglass) — KEY-GATED; without it the heatmap honestly
#     reports available=False.
#   • Crypto on-chain SOPR / MVRV z-score (bitcoin-data.com) — free, no key required; an
#     optional key raises rate limits. Fear & Greed (alternative.me) is free/keyless.
#   • FII/DII cash flows + NSE corporate announcements — public NSE endpoints, NO key
#     (a browser User-Agent + warmed-up session cookie; offline via injected fetchers).
#   • Autonomous web researcher — uses the EXISTING LLM keys (see core.llm / OPENAI_* above)
#     for summarisation + `ddgs` (DuckDuckGo) for search; degrades to an extractive digest
#     with no LLM. Riskfolio/stress/arb/RL-exit need NO keys.
# PLACEHOLDERS only — never commit real secrets (.env is gitignored).
COINGLASS_API_KEY=
BITCOINDATA_API_KEY=
